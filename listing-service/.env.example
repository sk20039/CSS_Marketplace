# listing-service environment variables
# Copy to .env and fill in real values.
# Variables marked [REQUIRED in production] must be set when NODE_ENV=production.

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED in production] PostgreSQL connection string.
DATABASE_URL=postgres://listing_user:listing_pass@localhost:5432/listing_db

# Test database (used by npm test; never point at your production database).
DATABASE_URL_TEST=postgres://listing_user:listing_pass@localhost:5432/listing_db_test

# ── JWT / Internal auth ───────────────────────────────────────────────────────
# [REQUIRED in production] Minimum 32 characters. Must match auth-service and escrow-service.
JWT_SECRET=replace-with-32-plus-char-random-string

# [Optional] When set, escrow-service uses this dedicated secret for the
# x-internal-secret header instead of JWT_SECRET.
# Must match INTERNAL_SERVICE_SECRET in escrow-service.
INTERNAL_SERVICE_SECRET=

# ── URLs ──────────────────────────────────────────────────────────────────────
# [REQUIRED in production] Frontend origin for CORS. Must be HTTPS.
FRONTEND_ORIGIN=http://localhost:3003

# [REQUIRED in production] Public base URL of this service (used for photo links in social posts).
# Must be HTTPS. Example: https://listing.yourdomain.com
PUBLIC_BASE_URL=

# ── Photo storage ─────────────────────────────────────────────────────────────
# [Optional] Absolute path to the uploads directory.
# Default: listing-service/uploads/ (local disk — not suitable for multi-instance deployments).
UPLOADS_DIR=

# ── Social posting (Blotato) ──────────────────────────────────────────────────
# [Optional] All three must be set to enable social posts on new listings.
BLOTATO_ENABLED=false
BLOTATO_API_KEY=
BLOTATO_ACCOUNTS=

# ── SEO suggestions (Claude AI) ───────────────────────────────────────────────
# [Optional] Falls back to rule-based templates when not set.
ANTHROPIC_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3002
