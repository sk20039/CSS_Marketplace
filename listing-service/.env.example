PORT=3002
JWT_SECRET=change-me
FRONTEND_ORIGIN=http://localhost:3003
DB_PATH=./data/listing.sqlite3
UPLOADS_DIR=./uploads

# Optional: auto-post new listings to social media via Blotato
# (https://www.blotato.com). Dormant by default - leave BLOTATO_ENABLED as
# false (or unset) and nothing here does anything. See blotatoService.js
# for the full explanation of how to turn it on when you're ready.
BLOTATO_ENABLED=false
BLOTATO_API_KEY=
# JSON array, one entry per connected social account to post to, e.g.:
# [{"platform":"twitter","accountId":"acc_123","target":{"targetType":"profile"}}]
BLOTATO_ACCOUNTS=[]
# This service's own public URL (so photo links in posts are reachable).
# In production this is https://css-marketplace-listing-sal2026.onrender.com
PUBLIC_BASE_URL=http://localhost:3002
