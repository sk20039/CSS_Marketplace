# PostgreSQL connection string for the listing service.
# Replace credentials to match your docker-compose.yml or managed PG instance.
DATABASE_URL=postgres://listing_user:listing_pass@localhost:5432/listing_db

# Used by listing tests -- points at an isolated test database.
DATABASE_URL_TEST=postgres://listing_user:listing_pass@localhost:5432/listing_db_test

# Shared secret (must match auth-service and escrow-service).
JWT_SECRET=change-me

PORT=3002
