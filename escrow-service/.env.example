# escrow-service environment variables
# Copy to .env and fill in real values.
# Variables marked [REQUIRED in production] must be set when NODE_ENV=production.

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED in production] PostgreSQL connection string.
DATABASE_URL=postgres://escrow_user:escrow_pass@127.0.0.1:5432/escrow_db

# Test database (used by npm test; never point at your production database).
DATABASE_URL_TEST=postgres://escrow_user:escrow_pass@127.0.0.1:5432/escrow_db_test

# ── JWT / Internal auth ───────────────────────────────────────────────────────
# [REQUIRED in production] Minimum 32 characters. Must match auth-service and listing-service.
JWT_SECRET=replace-with-32-plus-char-random-string

# [REQUIRED in production] Minimum 32 characters. Separate secret for admin-role tokens.
ADMIN_JWT_SECRET=replace-with-different-32-plus-char-random-string

# [REQUIRED in production] Minimum 32 characters. Used as x-internal-secret header when
# calling listing-service. Must match INTERNAL_SERVICE_SECRET in listing-service.
INTERNAL_SERVICE_SECRET=replace-with-another-32-plus-char-random-string

# ── Stripe ────────────────────────────────────────────────────────────────────
# [REQUIRED in production] Stripe secret key (sk_live_... for production, sk_test_... for testing).
# Leave unset to use the built-in stub client (simulated, no network calls).
STRIPE_SECRET_KEY=

# ── Shippo ────────────────────────────────────────────────────────────────────
# [REQUIRED in production] Shippo API key for label purchase and tracking.
# Leave unset to use stub mode (local dev and tests only).
SHIPPO_API_KEY=

# [REQUIRED in production] Webhook URL token for POST /webhooks/shippo.
# Append ?token=<value> to the webhook URL registered in the Shippo dashboard.
# Must be at least 32 random characters.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset in production: all webhook requests return 401.
SHIPPO_WEBHOOK_TOKEN=

# ── Internal service URLs ─────────────────────────────────────────────────────
# [REQUIRED in production] Base URL of listing-service. HTTP is allowed for private VPC URLs.
# Must not be localhost in production.
LISTING_SERVICE_URL=http://localhost:3002

# ── Public URLs ───────────────────────────────────────────────────────────────
# [REQUIRED in production] Frontend origin for CORS. Must be HTTPS.
FRONTEND_ORIGIN=http://localhost:3003

# [REQUIRED in production] Public base URL of the app (used in email links). Must be HTTPS.
APP_BASE_URL=http://localhost:3003

# ── Order lifecycle settings ──────────────────────────────────────────────────
# [Optional] Hours after "delivered" before funds auto-release. Default: 48.
DELIVERY_WINDOW_HOURS=48

# [Optional] Platform fee in basis points (800 = 8%). Default: 800.
PLATFORM_FEE_BPS=800

# [Optional] Minimum platform fee in cents (200 = $2.00). Default: 200.
MIN_PLATFORM_FEE_CENTS=200

# [Optional] node-cron schedule for the auto-release sweep. Default: every minute.
# Consider "0 * * * *" (hourly) in production to reduce DB load.
RELEASE_CHECK_CRON=* * * * *

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# [REQUIRED in production] All four must be set — lifecycle emails must not silently
# drop in production. Use an SMTP relay (e.g. smtp.resend.com:587, user=resend,
# pass=<RESEND_API_KEY>) or any transactional SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Your App <noreply@yourdomain.com>

# ── Dispute evidence storage ──────────────────────────────────────────────────
# [REQUIRED in production] Absolute path to the directory where dispute evidence
# files are stored. Must point to a persistent volume mount path (e.g. /evidence
# on Railway). Without this, evidence is lost on every deployment.
# Default for local dev: escrow-service/evidence/ (created automatically if absent).
EVIDENCE_DIR=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
