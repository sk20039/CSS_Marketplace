# Copy to .env to customize. All values are optional; sane defaults are used.

# Server port
PORT=3000

# Leave unset / empty to use the STUB Stripe client (no network calls, no key
# needed - default for local dev and the demo UI). Set to a real Stripe test
# secret key (sk_test_...) to switch to the REAL Stripe client, which uses
# Stripe Connect test mode (separate-charges-and-transfers pattern).
STRIPE_SECRET_KEY=

# Delivery window (hours) after "delivered" before auto-release fires.
DELIVERY_WINDOW_HOURS=48

# Platform fee in basis points (300 = 3%).
PLATFORM_FEE_BPS=300

# node-cron schedule for the auto-release sweep. Default: every minute.
# node-cron also supports an optional seconds field, e.g. "*/10 * * * * *"
# for every 10 seconds if you want to see auto-release fire faster in a demo
# (combine with a very small DELIVERY_WINDOW_HOURS, e.g. 0.001 for ~3.6s).
RELEASE_CHECK_CRON=* * * * *

# Optional: override the SQLite file location.
# DB_PATH=./data/escrow.sqlite3

# Frontend origin for CORS.
FRONTEND_ORIGIN=http://localhost:3003

# Shared secret for verifying JWTs issued by auth-service. Must match
# auth-service's and listing-service's JWT_SECRET.
JWT_SECRET=change-me

# Optional: separate secret used to sign and verify admin-role JWTs.
# When set in both auth-service and escrow-service, admin tokens are signed
# with this key instead of JWT_SECRET — a leaked regular user token cannot
# be used to access admin endpoints. Leave unset to use JWT_SECRET for all
# roles (backwards-compatible default).
ADMIN_JWT_SECRET=

# listing-service base URL. Order creation fetches the listing's price and
# seller_id from here directly (the source of truth) rather than trusting
# the locally-mirrored copy populated by /api/sync/listing.
LISTING_SERVICE_URL=http://localhost:3002
