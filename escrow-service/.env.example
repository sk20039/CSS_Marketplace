# Escrow service environment variables
# Copy to .env and fill in real values for local development.

# PostgreSQL connection strings
DATABASE_URL=postgres://escrow_user:escrow_pass@127.0.0.1:5432/escrow_db
DATABASE_URL_TEST=postgres://escrow_user:escrow_pass@127.0.0.1:5432/escrow_db_test

# Stripe — leave unset to use the built-in stub client (no network calls)
STRIPE_SECRET_KEY=

# Delivery window (hours) after "delivered" before auto-release fires.
DELIVERY_WINDOW_HOURS=48

# Platform fee in basis points (300 = 3%).
PLATFORM_FEE_BPS=300

# node-cron schedule for the auto-release sweep. Default: every minute.
RELEASE_CHECK_CRON=* * * * *

# Frontend origin for CORS.
FRONTEND_ORIGIN=http://localhost:3003

# Shared secret for verifying JWTs issued by auth-service.
JWT_SECRET=change-me

# Optional: separate secret for admin-role JWTs.
ADMIN_JWT_SECRET=

# listing-service base URL
LISTING_SERVICE_URL=http://localhost:3002

# App base URL for email links
APP_BASE_URL=http://localhost:3003

PORT=3000
