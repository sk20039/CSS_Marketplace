# BA Report — environment variables
# Never commit real values. This file documents what's needed.
#
# Obtain these by:
#   1. Start Railway tunnels in two separate terminals:
#        railway connect Postgres-auth --environment production --tunnel-only --port 15440
#        railway connect Postgres-listing-escrow --environment production --tunnel-only --port 15441
#
#   2. Extract tunnel URLs (replaces internal hostname with localhost):
#        export DATABASE_URL_AUTH=$(railway variables --service auth-service --environment production --json 2>/dev/null \
#          | node -e "const v=JSON.parse(require('fs').readFileSync(0,'utf8'));const u=new URL(v.DATABASE_URL);u.hostname='localhost';u.port='15440';process.stdout.write(u.toString())")
#
#        export DATABASE_URL_LISTING=$(railway variables --service listing-service --environment production --json 2>/dev/null \
#          | node -e "const v=JSON.parse(require('fs').readFileSync(0,'utf8'));const u=new URL(v.DATABASE_URL);u.hostname='localhost';u.port='15441';process.stdout.write(u.toString())")
#
#        export DATABASE_URL_ESCROW=$(railway variables --service escrow-service --environment production --json 2>/dev/null \
#          | node -e "const v=JSON.parse(require('fs').readFileSync(0,'utf8'));const u=new URL(v.DATABASE_URL);u.hostname='localhost';u.port='15441';process.stdout.write(u.toString())")
#
#   3. node scripts/ba_report.js

DATABASE_URL_AUTH=postgresql://USER:PASSWORD@localhost:15440/railway
DATABASE_URL_LISTING=postgresql://USER:PASSWORD@localhost:15441/listing_db
DATABASE_URL_ESCROW=postgresql://USER:PASSWORD@localhost:15441/escrow_db
