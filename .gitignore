# dependencies
node_modules/

# local runtime data (regenerates on npm start)
escrow-service/data/*.sqlite3
escrow-service/data/*.sqlite3-shm
escrow-service/data/*.sqlite3-wal
auth-service/data/*.sqlite3
auth-service/data/*.sqlite3-shm
auth-service/data/*.sqlite3-wal
listing-service/data/*.sqlite3
listing-service/data/*.sqlite3-shm
listing-service/data/*.sqlite3-wal

# uploaded photos
listing-service/uploads/

# Next.js build output
frontend/.next/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# env secrets - never commit real keys
.env
.env.local
escrow-service/.env
auth-service/.env
listing-service/.env
frontend/.env.local

# Vercel project metadata (contains project/org IDs — not secrets but not needed in repo)
.vercel/
frontend/.vercel/

# Playwright / CI test artefacts
test-results/
playwright-report/

# Diagnostic and one-off scripts
scripts/diag_posthog*.py
scripts/verify_posthog*.py
scripts/configure_prod_vars.py

# BA report generated output — never commit
scripts/ba_report_*.md

# scratch/leftover
_to_delete/
escrow-service/_to_delete/

# Video production assets — large binaries, never commit
video_output/

# OS/editor
.DS_Store
Thumbs.db

# Local Claude Code skills and settings
.agents/
.claude/
skills-lock.json
