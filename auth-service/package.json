{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication service for USA Cricket Marketplace",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate -m migrations up",
    "migrate:down": "node-pg-migrate -m migrations down",
    "install:prod": "npm ci --omit=dev",
    "test:smoke": "node tests/smoke.test.js",
    "test": "node tests/auth.test.js && node tests/health.test.js && node tests/config.test.js && node tests/smoke.test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^7.0.0",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
