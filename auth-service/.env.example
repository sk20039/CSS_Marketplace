# PostgreSQL connection string for the auth service.
DATABASE_URL=postgres://auth_user:auth_pass@127.0.0.1:5432/auth_db

# Used by auth tests -- points at an isolated test database.
DATABASE_URL_TEST=postgres://auth_user:auth_pass@127.0.0.1:5432/auth_db_test

# JWT signing secrets. ADMIN_JWT_SECRET is optional.
JWT_SECRET=change-me
ADMIN_JWT_SECRET=

# Stripe Connect (required for real payout flows)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PORT=3001
