PORT=3001
JWT_SECRET=change-me
FRONTEND_ORIGIN=http://localhost:3003
DB_PATH=./data/auth.sqlite3

# Optional: separate secret for signing admin-role JWTs. When set, admin tokens
# are signed with this key instead of JWT_SECRET so regular user tokens are
# rejected by admin-only endpoints in escrow-service even if role='admin' is
# embedded in them. Must match ADMIN_JWT_SECRET in escrow-service/.env.
# Leave unset to use JWT_SECRET for all roles (backwards-compatible default).
ADMIN_JWT_SECRET=
