# auth-service environment variables
# Copy to .env and fill in real values.
# Variables marked [REQUIRED in production] must be set when NODE_ENV=production.

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED in production] PostgreSQL connection string.
DATABASE_URL=postgres://auth_user:auth_pass@127.0.0.1:5432/auth_db

# Test database (used by npm test; never point at your production database).
DATABASE_URL_TEST=postgres://auth_user:auth_pass@127.0.0.1:5432/auth_db_test

# ── JWT ───────────────────────────────────────────────────────────────────────
# [REQUIRED in production] Minimum 32 characters. Must match escrow-service and listing-service.
JWT_SECRET=replace-with-32-plus-char-random-string

# [REQUIRED in production] Minimum 32 characters. Separate secret for admin-role tokens.
# When set, admin tokens are only accepted by endpoints that verify against this secret.
ADMIN_JWT_SECRET=replace-with-different-32-plus-char-random-string

# ── Stripe ────────────────────────────────────────────────────────────────────
# [REQUIRED in production] Stripe secret key (sk_live_... for production, sk_test_... for testing).
STRIPE_SECRET_KEY=

# [REQUIRED in production] Stripe webhook signing secret (whsec_...).
# Obtain from the Stripe Dashboard → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=

# ── URLs ──────────────────────────────────────────────────────────────────────
# [REQUIRED in production] Frontend origin for CORS. Must be HTTPS.
FRONTEND_ORIGIN=http://localhost:3003

# [REQUIRED in production] Public base URL of the app (used in email links). Must be HTTPS.
APP_BASE_URL=http://localhost:3003

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# [Optional] If not set, emails are logged to the console only (stub mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
